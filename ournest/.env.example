# Supabase project (Project Settings → API). Both values are safe to expose
# to the browser: all data access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# NEVER prefix the service-role key with NEXT_PUBLIC_ and never use it in
# app code. It is only needed by optional admin scripts / CI database tests.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: Postgres URL used by `npm run test:db` (privacy/RLS test suite).
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
